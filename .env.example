# ─── Frontend (prefijo VITE_ ⇒ visible en el bundle; SOLO valores públicos) ───
# URL del proyecto Supabase (pública)
VITE_SUPABASE_URL=
# Anon key de Supabase (pública por diseño; los datos se protegen con RLS)
VITE_SUPABASE_ANON_KEY=

# ─── Puerta de acceso de DEMO (pública; NO es seguridad real) ───
# Credenciales de la pantalla de login del piloto. Si se omiten, se usan las
# de prueba documentadas (admin1 / 1234). Al ser una app de solo-navegador,
# cualquier valor aquí acaba en el bundle: no es un secreto real.
VITE_DEMO_USER=admin1
VITE_DEMO_PASSWORD=1234

# ─── Solo servidor (Supabase Edge Functions / Vercel env) ───
# NUNCA con prefijo VITE_. Nunca en Git.
# Clave de Twelve Data para el proxy de mercado
TWELVE_DATA_API_KEY=
# Lista separada por comas; ejemplo:
# https://ignacior04.github.io,http://localhost:5173
ALLOWED_ORIGINS=
