{
  "name": "riskcalculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint src e2e playwright.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle:budget",
    "verify:fase2": "vitest run src/features/lab/context/fase2.test.ts --reporter=verbose",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "bench:stability": "node scripts/bench-stability.mjs",
    "bench:dependency": "node scripts/bench-dependency.mjs",
    "bench:scenarios": "node scripts/bench-scenarios.mjs",
    "bench:candidates": "node scripts/bench-candidates.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "decimal.js": "^10.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
