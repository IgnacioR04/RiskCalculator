{
  "name": "riskcalculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint src e2e playwright.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle:budget",
    "verify:fase2": "vitest run src/features/lab/context/fase2.test.ts --reporter=verbose",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "bench:stability": "node scripts/bench-stability.mjs",
    "bench:dependency": "node scripts/bench-dependency.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "decimal.js": "^10.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
